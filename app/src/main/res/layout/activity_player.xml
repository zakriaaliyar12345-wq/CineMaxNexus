<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/player_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nexus_black">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="@color/nexus_black"
        app:show_buffering="never"
        app:surface_type="texture_view"
        app:use_controller="false" />
    <com.cinemax.nexus.player.GestureCatcherView
        android:id="@+id/gesture_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <ImageView
        android:id="@+id/lock_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_control_button"
        android:contentDescription="@string/unlock"
        android:padding="14dp"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:tint="@color/nexus_text" />
    <FrameLayout
        android:id="@+id/control_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">
        <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_player_top">
            <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="11dp"
        android:src="@drawable/ic_back"
        app:tint="@color/nexus_text" />
            <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">
                <TextView
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="@color/nexus_text"
        android:textSize="16sp"
        android:textStyle="bold" />
                <TextView
        android:id="@+id/decoder_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:background="?attr/selectableItemBackground"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="11sp" />
            </LinearLayout>
            <ImageButton
        android:id="@+id/btn_speed"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/speed"
        android:padding="11dp"
        android:src="@drawable/ic_speed"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_subtitles"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/subtitles"
        android:padding="11dp"
        android:src="@drawable/ic_subtitle"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_more_dialog"
        android:padding="11dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/nexus_text" />
        </LinearLayout>
        <LinearLayout
        android:id="@+id/player_transport"
          android:layoutDirection="ltr"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:background="@drawable/bg_hud_pill">
            <ImageButton
        android:id="@+id/btn_prev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/previous"
        android:padding="12dp"
        android:src="@drawable/ic_prev"
        app:tint="@color/nexus_text" />
            <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_play_primary"
        android:contentDescription="@string/play"
        android:padding="14dp"
        android:src="@drawable/ic_play"
        app:tint="@color/nexus_black" />
            <ImageButton
        android:id="@+id/btn_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/next"
        android:padding="12dp"
        android:src="@drawable/ic_next"
        app:tint="@color/nexus_text" />
        </LinearLayout>
        <LinearLayout
        android:id="@+id/compact_transport_bar"
          android:layoutDirection="ltr"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_player_bottom">
            <TextView
        android:id="@+id/position_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/nexus_text"
        android:textSize="12sp" />
            <com.cinemax.nexus.player.BufferedSeekBar
        android:id="@+id/seek_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:maxHeight="18dp"
        android:minHeight="18dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/nexus_accent"
        android:splitTrack="false"
        android:thumbTint="@color/nexus_accent"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"  android:layoutDirection="ltr"/>
            <TextView
        android:id="@+id/duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/nexus_text"
        android:textSize="12sp" />
            <ImageButton
        android:id="@+id/btn_rotate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rotate_screen"
        android:padding="12dp"
        android:src="@drawable/ic_screen_rotation"
        app:tint="@color/nexus_accent" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="52dp"
        android:layout_marginStart="20dp"
        android:orientation="horizontal">
            <TextView
        android:id="@+id/ab_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/nexus_accent"
        android:textSize="12sp"
        android:visibility="gone" />
            <TextView
        android:id="@+id/speed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@color/nexus_accent"
        android:textSize="12sp"
        android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
            <ImageButton
        android:id="@+id/btn_pip"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_pip"
        android:padding="11dp"
        android:src="@drawable/ic_pip"
        app:tint="@color/nexus_text" />
            <ImageButton
        android:id="@+id/btn_lock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lock"
        android:padding="11dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_shuffle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/shuffle"
        android:padding="11dp"
        android:src="@drawable/ic_shuffle"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_repeat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/repeat"
        android:padding="11dp"
        android:src="@drawable/ic_repeat"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_queue"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/queue"
        android:padding="11dp"
        android:src="@drawable/ic_queue"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_ratio"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/aspect_ratio"
        android:padding="11dp"
        android:src="@drawable/ic_ratio"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_audio"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/audio_track"
        android:padding="11dp"
        android:src="@drawable/ic_audio"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_timer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sleep_timer"
        android:padding="11dp"
        android:src="@drawable/ic_timer"
        app:tint="@color/nexus_text_secondary" />
            <ImageButton
        android:id="@+id/btn_info"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/video_info"
        android:padding="11dp"
        android:src="@drawable/ic_tune"
        app:tint="@color/nexus_text_secondary" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <TextView
        android:id="@+id/hud_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
        <com.cinemax.nexus.player.BufferedSeekBar
        android:id="@+id/hud_progress"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/nexus_accent"
        android:splitTrack="false"
        android:thumb="@null"
        android:thumbTint="@color/nexus_accent"  android:layoutDirection="ltr"/>
    </LinearLayout>
    <TextView
        android:id="@+id/seek_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud_pill"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom" />
    <TextView
        android:id="@+id/secondary_captions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:layout_marginHorizontal="24dp"
        android:padding="8dp"
        android:background="@drawable/bg_subtitle_toast"
        android:textColor="@color/nexus_accent"
        android:textSize="20sp"
        android:gravity="center"
        android:visibility="gone" />
    <TextView
        android:id="@+id/subtitle_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="170dp"
        android:background="@drawable/bg_subtitle_toast"
        android:gravity="center"
        android:maxWidth="900dp"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/timer_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_hud_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/nexus_accent"
        android:textSize="13sp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/nexus_accent"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/error_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">
        <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/playback_error"
        android:textColor="@color/nexus_text"
        android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/retry"
        app:backgroundTint="@color/nexus_accent" />
    </LinearLayout>
    <LinearLayout android:id="@+id/scrub_preview" android:layout_width="164dp" android:layout_height="wrap_content" android:layout_gravity="bottom|left" android:layout_marginBottom="76dp" android:orientation="vertical" android:background="@drawable/bg_scrub_preview" android:visibility="gone" android:elevation="8dp">
        <ImageView android:id="@+id/scrub_frame" android:layout_width="match_parent" android:layout_height="84dp" android:scaleType="centerCrop" android:contentDescription="@string/study_seek_preview" />
        <TextView android:id="@+id/scrub_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:gravity="center" android:textColor="@color/nexus_text" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</FrameLayout>
