<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginVertical="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="?attr/selectableItemBackground" android:foreground="?attr/selectableItemBackground">
    <com.google.android.material.imageview.ShapeableImageView xmlns:app="http://schemas.android.com/apk/res-auto" app:shapeAppearanceOverlay="@style/Shape.NexusCover" android:id="@+id/audio_art" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/ic_album_orbit" />
