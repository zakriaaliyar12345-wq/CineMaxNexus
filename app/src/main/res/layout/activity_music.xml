<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/nexus_black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/music_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_back" app:tint="@color/nexus_text" android:contentDescription="@string/back" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/music" android:textColor="@color/nexus_text" android:textSize="22sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/music_refresh" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_repeat" app:tint="@color/nexus_text_secondary" android:contentDescription="@string/refresh_library" />
        <com.google.android.material.button.MaterialButton android:id="@+id/music_open" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/open_audio" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:id="@+id/music_headline" android:text="@string/immersive_music_headline" android:textColor="@color/nexus_text" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        <TextView android:letterSpacing="0.03" android:id="@+id/music_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/music_description" android:textColor="@color/nexus_text_secondary" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/music_grant" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/music_allow" android:visibility="gone" />
        <EditText android:id="@+id/music_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_studio_panel" android:paddingHorizontal="16dp" android:hint="@string/music_search_hint" android:textColor="@color/nexus_text" android:textColorHint="@color/nexus_text_secondary" android:textSize="14sp" android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <TextView android:id="@+id/music_songs" style="@style/MusicFilter" android:text="@string/music_songs" />
            <TextView android:id="@+id/music_albums" style="@style/MusicFilter" android:text="@string/music_albums" />
            <TextView android:id="@+id/music_artists" style="@style/MusicFilter" android:text="@string/music_artists" />
            <TextView android:id="@+id/music_favorites" style="@style/MusicFilter" android:text="@string/filter_favorites" />
        </LinearLayout>
        <TextView android:id="@+id/music_collection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="@string/music_collection_title" android:textColor="@color/nexus_text" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/music_list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp" android:paddingBottom="8dp" android:clipToPadding="false" />
        <TextView android:id="@+id/music_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:text="@string/music_empty" android:textColor="@color/nexus_text_secondary" android:visibility="gone" />
        <ProgressBar android:id="@+id/music_progress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/music_mini" android:elevation="8dp" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:padding="10dp" android:gravity="center_vertical" android:background="@drawable/bg_aurora" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
        <ImageView android:id="@+id/music_mini_art" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_music_art" android:contentDescription="@null" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp">
            <TextView android:id="@+id/music_mini_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/nexus_text" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/music_mini_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/nexus_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/music_mini_play" style="@style/MusicIcon" android:src="@drawable/ic_play" android:contentDescription="@string/play" app:tint="@color/nexus_accent" />
        <ImageButton android:id="@+id/music_mini_next" style="@style/MusicIcon" android:src="@drawable/ic_next" android:contentDescription="@string/next" />
    </LinearLayout>
</LinearLayout>

