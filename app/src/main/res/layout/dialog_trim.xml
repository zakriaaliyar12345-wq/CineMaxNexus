<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/trim_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nexus_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="0:05 → 0:15 · 10.0s" />

    <TextView
        android:id="@+id/trim_start_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/trim_start"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/trim_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/nexus_accent"
        android:thumbTint="@color/nexus_accent"  android:layoutDirection="ltr"/>

    <TextView
        android:id="@+id/trim_end_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/trim_end"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/trim_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/nexus_accent"
        android:thumbTint="@color/nexus_accent"  android:layoutDirection="ltr"/>

    <TextView
        android:id="@+id/trim_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/trim_destination"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
