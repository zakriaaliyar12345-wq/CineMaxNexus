<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="5dp" android:background="@drawable/bg_studio_panel" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="14dp" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/study_row_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/nexus_accent" android:textSize="12sp" android:fontFamily="monospace" />
    <TextView android:id="@+id/study_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/nexus_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="5" android:ellipsize="end" />
    <TextView android:id="@+id/study_row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/nexus_text_secondary" android:textSize="13sp" android:maxLines="4" android:ellipsize="end" />
    <ImageView android:id="@+id/study_row_image" android:layout_width="match_parent" android:layout_height="136dp" android:layout_marginTop="8dp" android:contentDescription="@string/study_snapshot" android:scaleType="centerInside" android:visibility="gone" />
</LinearLayout>
